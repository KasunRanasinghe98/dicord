# Local Postgres (docker-compose up -d db). Point this at Neon/Supabase for staging/prod.
DATABASE_URL="postgresql://dc:dc@localhost:5432/digital_coordinator"

# Session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# SMS provider for OTP delivery. "console" logs the code to the server console
# instead of sending a real SMS — use it for local dev. "twilio" sends a
# real SMS via Twilio's REST API (src/server/auth/sms.ts) and requires the
# three TWILIO_* vars below. Note: a Twilio trial account can only send to
# phone numbers you've manually verified in the Twilio console.
SMS_PROVIDER="console"
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# Platform fee charged to the employer per successfully completed
# worker-shift (blueprint §18 — must stay configurable, never hard-coded).
PLATFORM_FEE_PER_WORKER="300.00"
